{
  "name": "planktonzilla-taxonomy",
  "title": "planktonzilla source-label to taxon-concept mapping",
  "description": "The schema of record for the normalised taxonomy package. Executed by planktonzilla.planktonzilla_dataset.taxonomy.validate, which needs nothing but polars and the standard library -- so pre-flight on a laptop gives CI's verdict. Shaped as a Frictionless Data Package so the descriptor stays readable to that toolchain, with two project extensions its validator ignores: `vocabulary` on a field constraint (the value must appear in a vocab table) and `uniqueKeys` (which Frictionless 5.19 parses but does not enforce -- measured).",
  "profile": "tabular-data-package",
  "dialect": {
    "delimiter": "\t",
    "lineTerminator": "\n",
    "quoteChar": "",
    "header": true
  },
  "resources": [
    {
      "name": "taxon",
      "path": "taxon.tsv",
      "description": "One row per node: the rank tree, plus lineage-less buckets.",
      "schema": {
        "fields": [
          {
            "name": "taxonID",
            "type": "string",
            "description": "Opaque, never renamed, never reused.",
            "constraints": {
              "required": true,
              "pattern": "^pzt:[0-9]{6}$"
            }
          },
          {
            "name": "parentNameUsageID",
            "type": "string",
            "description": "Empty at a root.",
            "constraints": {
              "pattern": "^(pzt:[0-9]{6})?$"
            }
          },
          {
            "name": "taxonRank",
            "type": "string",
            "description": "",
            "constraints": {
              "required": true,
              "vocabulary": "rank#rank"
            }
          },
          {
            "name": "scientificName",
            "type": "string",
            "description": "Binomial at species rank; the epithet is projected.",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "taxonomicStatus",
            "type": "string",
            "description": "",
            "constraints": {
              "required": true,
              "enum": [
                "accepted",
                "synonym",
                "misapplied"
              ]
            }
          },
          {
            "name": "acceptedNameUsageID",
            "type": "string",
            "description": "",
            "constraints": {
              "pattern": "^(pzt:[0-9]{6})?$"
            }
          },
          {
            "name": "nameAccordingTo",
            "type": "string",
            "description": "The classification followed, where two placements coexist."
          },
          {
            "name": "kind",
            "type": "string",
            "description": "",
            "constraints": {
              "required": true,
              "vocabulary": "kind#kind"
            }
          },
          {
            "name": "taxonRemarks",
            "type": "string",
            "description": ""
          }
        ],
        "primaryKey": [
          "taxonID"
        ],
        "uniqueKeys": [
          [
            "scientificName",
            "taxonRank",
            "parentNameUsageID"
          ]
        ],
        "foreignKeys": [
          {
            "fields": [
              "parentNameUsageID"
            ],
            "reference": {
              "resource": "taxon",
              "fields": [
                "taxonID"
              ]
            }
          },
          {
            "fields": [
              "acceptedNameUsageID"
            ],
            "reference": {
              "resource": "taxon",
              "fields": [
                "taxonID"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "identifier",
      "path": "identifier.tsv",
      "description": "One external id per line, SSSOM-shaped. An absence is a row, not a blank.",
      "schema": {
        "fields": [
          {
            "name": "subject_id",
            "type": "string",
            "description": "",
            "constraints": {
              "required": true,
              "pattern": "^pzt:[0-9]{6}$"
            }
          },
          {
            "name": "predicate_id",
            "type": "string",
            "description": "",
            "constraints": {
              "required": true,
              "enum": [
                "skos:exactMatch",
                "skos:broadMatch",
                "skos:narrowMatch",
                "skos:closeMatch",
                "sssom:NoTermFound"
              ]
            }
          },
          {
            "name": "object_id",
            "type": "string",
            "description": "",
            "constraints": {
              "required": true,
              "pattern": "^[a-z_]+:([A-Za-z0-9]+|absent)$"
            }
          },
          {
            "name": "mapping_justification",
            "type": "string",
            "description": "",
            "constraints": {
              "required": true,
              "enum": [
                "semapv:UnspecifiedMatching",
                "semapv:ManualMappingCuration",
                "semapv:LexicalMatching"
              ]
            }
          },
          {
            "name": "mapping_date",
            "type": "string",
            "description": "A string, never a date type: a spreadsheet round trip rewrites dates."
          },
          {
            "name": "author_id",
            "type": "string",
            "description": ""
          },
          {
            "name": "confidence",
            "type": "string",
            "description": ""
          },
          {
            "name": "comment",
            "type": "string",
            "description": ""
          }
        ],
        "primaryKey": [
          "subject_id",
          "predicate_id",
          "object_id"
        ],
        "foreignKeys": [
          {
            "fields": [
              "subject_id"
            ],
            "reference": {
              "resource": "taxon",
              "fields": [
                "taxonID"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "mapping",
      "description": "One file per source. `pathGlob` is a project extension: the descriptor declares the SHAPE of a mapping file and nothing about which sources exist, because enumerating them here would be a second source registry beside constants.DATASET_IMPORT_CONFIGS -- two lists that drift, and a line both branches of a concurrent add-source PR insert at the same position (measured: it conflicted). The registry is constants.DATASET_IMPORT_CONFIGS, which adding a source already has to touch for validate_license_coverage. Each file's datasetID must equal its own stem.",
      "schema": {
        "fields": [
          {
            "name": "datasetID",
            "type": "string",
            "description": "Must equal the file stem.",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "verbatimIdentification",
            "type": "string",
            "description": "The class-directory name, byte-exact.",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "taxonID",
            "type": "string",
            "description": "",
            "constraints": {
              "required": true,
              "pattern": "^pzt:[0-9]{6}$"
            }
          },
          {
            "name": "concept",
            "type": "string",
            "description": "The display name; must equal the taxon's scientificName.",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "root_class",
            "type": "string",
            "description": "",
            "constraints": {
              "required": true,
              "vocabulary": "root_class#root_class"
            }
          },
          {
            "name": "qualifier",
            "type": "string",
            "description": "",
            "constraints": {
              "required": true,
              "vocabulary": "qualifier#qualifier"
            }
          },
          {
            "name": "plankton",
            "type": "string",
            "description": "",
            "constraints": {
              "required": true,
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "status",
            "type": "string",
            "description": "`draft` is skipped by the renderer and the coverage rule.",
            "constraints": {
              "required": true,
              "enum": [
                "accepted",
                "draft"
              ]
            }
          },
          {
            "name": "method",
            "type": "string",
            "description": ""
          },
          {
            "name": "donor",
            "type": "string",
            "description": ""
          },
          {
            "name": "identifiedBy",
            "type": "string",
            "description": ""
          },
          {
            "name": "dateIdentified",
            "type": "string",
            "description": ""
          },
          {
            "name": "identificationReferences",
            "type": "string",
            "description": ""
          },
          {
            "name": "confidence",
            "type": "string",
            "description": ""
          },
          {
            "name": "remarks",
            "type": "string",
            "description": ""
          }
        ],
        "primaryKey": [
          "datasetID",
          "verbatimIdentification"
        ],
        "foreignKeys": [
          {
            "fields": [
              "taxonID"
            ],
            "reference": {
              "resource": "taxon",
              "fields": [
                "taxonID"
              ]
            }
          }
        ]
      },
      "pathGlob": "mappings/*.tsv"
    },
